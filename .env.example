# Copy to .env and adjust as needed: cp .env.example .env

# --- Data locations ---
ASL_TRAIN_DIR=dataset/asl_alphabet_train
ASL_TEST_DIR=dataset/asl_alphabet_test
ASL_LANDMARKS_DIR=dataset/landmarks
ASL_MODEL_DIR=models

# --- Hand landmark detection (MediaPipe) ---
LANDMARK_MIN_CONFIDENCE=0.3
LANDMARK_NUM_HANDS=2

# --- Training ---
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS=100

# --- Stream decoding (live recognition) ---
DECODE_STABILITY=8
DECODE_MIN_CONFIDENCE=0.6

# --- Backend (used in later phases) ---
API_HOST=0.0.0.0
API_PORT=8000
WHISPER_MODEL=base
TTS_VOICE=en_US-amy-medium
