# Copy to .env and adjust as needed: cp .env.example .env

# --- Data locations ---
ASL_TRAIN_DIR=dataset/asl_alphabet_train
ASL_TEST_DIR=dataset/asl_alphabet_test
ASL_LANDMARKS_DIR=dataset/landmarks
ASL_MODEL_DIR=models
# May point at the training set or a smaller production directory containing
# one subdirectory/image per supported fingerspelling token.
ASL_SIGNS_DIR=dataset/asl_alphabet_train

# --- Hand landmark detection (MediaPipe) ---
LANDMARK_MIN_CONFIDENCE=0.3
LANDMARK_NUM_HANDS=1

# --- Training ---
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS=100
TRAIN_SEED=42

# --- Stream decoding (live recognition) ---
DECODE_STABILITY=8
DECODE_MIN_CONFIDENCE=0.6

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=26214400
MAX_FRAME_BYTES=2097152
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE=en_US-amy-medium
TTS_MODEL_PATH=voices/en_US-amy-medium.onnx
